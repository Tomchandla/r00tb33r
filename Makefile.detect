SRC_DIR = detector
SRCS    = ${SRC_DIR}/kcheck.c ${SRC_DIR}/kutil.c \
          ${SRC_DIR}/chk_sysent.c ${SRC_DIR}/chk_protox.c \
          ${SRC_DIR}/chk_icmp_hook.c ${SRC_DIR}/chk_modlist.c
CFLAGS += -O2 -Wall

all: kcheck

kcheck: ${SRCS} ${SRC_DIR}/kutil.h
	${CC} ${CFLAGS} -o ${.TARGET} ${SRCS} -lkvm

clean:
	rm -f kcheck

.PHONY: all clean
